# Шаблон переменных бота для Lockbox (список — bot/core/domain/const/env_const.py
# и bot/feature/business/di/llm_module.py). Скопируйте ВНЕ репозитория или в
# infra/secrets.<env>.env (игнорируется git), заполните и залейте:
#   make -C infra secrets ENV=test FILE=secrets.test.env
# Файл ключа YDB не нужен, если в envs/<env>.tfvars задан ydb_database_id
# (SA VM получает ydb.editor на эту базу). Иначе передайте ключ: YDB_KEY=...

# Режим токенов: True — BOT_TOKEN/BOT_TOKEN_ADMIN (тестовые боты), иначе *_RELEASE
DEBUG_MODE_TOKEN=True
DEBUG_MODE_LOGGING=False
DEBUG_MODE_TYPING=False
DEBUG_MODE_START_POLLING=False
DEBUG_MODE_DATABASE=False

BOT_TOKEN=
BOT_TOKEN_ADMIN=
BOT_TOKEN_RELEASE=
BOT_TOKEN_ADMIN_RELEASE=

YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_PATH=/ru-central1/b1g.../etn...

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

NEXT_MESSAGE_SEPARATOR=
NEXT_MESSAGE_SEPARATOR_REGEX=

ADMIN_ID_LIST=
OWN_CHANNEL_ID=
OWN_CHAT_ID=
